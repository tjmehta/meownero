+// Admission checks before starting any pool servers. RPC is trusted loopback.
+void p2pool::check_meownero_profile(uint64_t height)
+{
+    const Params::Host host = current_host();
+    const std::string request = "{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"get_block_header_by_height\",\"params\":{\"height\":" + std::to_string(height) + "}}";
+    JSONRPCRequest::call(host.m_address, host.m_rpcPort, request.c_str(), host.m_rpcLogin, m_params.m_socks5Proxy, host.m_rpcSSL, host.m_rpcSSL_Fingerprint,
+        [this, height, host](const JSONRPCRequest::CallbackData& data) {
+            ChainMain block;
+            if (parse_block_header(data.m_response.data(), data.m_response.size(), block)) {
+                hash genesis;
+                if (!from_hex(meownero::GENESIS, 64, genesis) || (block.height != height) ||
+                    ((height == 0) ? ((block.id != genesis) || (block.reward != 0)) : (block.reward != meownero::REWARD))) {
+                    LOGERR(1, "Meownero genesis/subsidy mismatch");
+                    PANIC_STOP();
+                }
+                if (height == 0) check_meownero_profile(1);
+                else get_miner_data();
+                return;
+            }
+            // No block 1 exists on a fresh chain. Its empty template must have
+            // the exact selected subsidy; no spendable funds exist for fees.
+            if (height != 1) {
+                LOGERR(1, "Meownero genesis unavailable");
+                PANIC_STOP();
+            }
+            char address[Wallet::ADDRESS_LENGTH + 1] = {};
+            char encoded[Wallet::ADDRESS_LENGTH];
+            m_params.m_miningWallet.encode(encoded);
+            memcpy(address, encoded, Wallet::ADDRESS_LENGTH);
+            const std::string req = std::string("{\"jsonrpc\":\"2.0\",\"id\":\"0\",\"method\":\"get_block_template\",\"params\":{\"wallet_address\":\"") + address + "\"}}";
+            JSONRPCRequest::call(host.m_address, host.m_rpcPort, req.c_str(), host.m_rpcLogin, m_params.m_socks5Proxy, host.m_rpcSSL, host.m_rpcSSL_Fingerprint,
+                [this](const JSONRPCRequest::CallbackData& reply) {
+                    rapidjson::Document doc;
+                    uint64_t h = 0, reward = 0;
+                    if (doc.Parse(reply.m_response.data(), reply.m_response.size()).HasParseError() || !doc.IsObject() ||
+                        !doc.HasMember("result") || !doc["result"].IsObject() ||
+                        !parseValue(doc["result"], "height", h) || !parseValue(doc["result"], "expected_reward", reward) ||
+                        (h != 1) || (reward != meownero::REWARD)) {
+                        LOGERR(1, "Meownero fresh-chain subsidy mismatch");
+                        PANIC_STOP();
+                    }
