-#define FINAL_SUBSIDY_PER_MINUTE                        ((uint64_t)300000000000) // 3 * pow(10, 11)
+#define FINAL_SUBSIDY_PER_MINUTE                        ((uint64_t)300000000000) // 3 * pow(10, 11) (unused by Meownero; kept for upstream diff hygiene)
+// Meownero: perpetual flat subsidy, 0.9 MEOW per block (PLAN.md rev 4 §8.1). Genesis pays 0.
+#define MEOW_BLOCK_REWARD                               ((uint64_t)900000000000) // 9 * pow(10, 11) = 0.9 * COIN
 
