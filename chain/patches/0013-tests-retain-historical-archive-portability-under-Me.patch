From 43e3220d549a7ee2839fb8777b961960543f664d Mon Sep 17 00:00:00 2001
From: Tejesh Mehta <tejesh.mehta@gmail.com>
Date: Mon, 7 Sep 2026 23:12:01 -0700
Subject: [PATCH] tests: retain historical archive portability under Meownero
 identity

Separate cache decoding from genesis acceptance using existing friend-test access and key-unlock guard. Preserve fixture bytes and field assertions; re-encode transaction address display expectations.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 tests/unit_tests/serialization.cpp | 45 ++++++++++++++++++------------
 1 file changed, 27 insertions(+), 18 deletions(-)

diff --git a/tests/unit_tests/serialization.cpp b/tests/unit_tests/serialization.cpp
index 0cf0275..48468d2 100644
--- a/tests/unit_tests/serialization.cpp
+++ b/tests/unit_tests/serialization.cpp
@@ -669,16 +669,25 @@ TEST(Serialization, portability_wallet)
   const cryptonote::network_type nettype = cryptonote::TESTNET;
   tools::wallet2 w(nettype);
   const boost::filesystem::path wallet_file = unit_test::data_dir / "wallet_9svHk1";
-  string password = "test";
-  bool r = false;
-  try
+  const string password = "test";
+  std::string keys, cache;
+  ASSERT_TRUE(epee::file_io_utils::load_file_to_string(wallet_file.string() + ".keys", keys));
+  ASSERT_TRUE(epee::file_io_utils::load_file_to_string(wallet_file.string(), cache));
+  EXPECT_THROW(w.load("", password, keys, cache), tools::error::wallet_internal_error);
+
+  // Existing friend-test access separates historical decoding from chain acceptance.
+  // Preserve every original cache field assertion below, without changing production validation.
+  ASSERT_NO_THROW(w.load("", password, keys));
   {
-    w.load(wallet_file.string(), password);
-    r = true;
+    // Legacy cache encryption derives from unlocked keys, as in wallet2::load.
+    tools::wallet_keys_unlocker unlocker(w,
+      w.m_ask_password == tools::wallet2::AskPasswordToDecrypt && !w.m_unattended &&
+      !w.m_watch_only && !w.m_is_background_wallet, password);
+    ASSERT_NO_THROW(w.load_wallet_cache(false, cache));
   }
-  catch (const exception& e)
-  {}
-  ASSERT_TRUE(r);
+  cryptonote::block genesis;
+  w.generate_genesis(genesis);
+  EXPECT_THROW(w.check_genesis(cryptonote::get_block_hash(genesis)), tools::error::wallet_internal_error);
   /*
   fields of tools::wallet2 to be checked: 
     std::vector<crypto::hash>                                       m_blockchain
@@ -997,15 +1006,15 @@ TEST(Serialization, portability_unsigned_tx)
