new file mode 100644
index 0000000..f2fb7f9
--- /dev/null
+++ b/tests/unit_tests/meow_authorities.cpp
@@ -0,0 +1,20 @@
+#include "gtest/gtest.h"
+#include "common/updates.h"
+
+TEST(meow_authorities, updates_fail_closed)
+{
+  for (const auto software : {"monero", "monero-gui", "meownero"})
+  {
+    std::string version = "stale version", hash = "stale hash";
+    ASSERT_FALSE(tools::check_updates(software, "source", version, hash));
+    ASSERT_TRUE(version.empty());
+    ASSERT_TRUE(hash.empty());
+  }
+}
+
+TEST(meow_authorities, no_download_urls)
+{
+  for (const auto software : {"monero", "monero-gui", "meownero"})
+    for (const bool user : {false, true})
+      ASSERT_TRUE(tools::get_update_url(software, "cli", "source", "999.0", user).empty());
+}
