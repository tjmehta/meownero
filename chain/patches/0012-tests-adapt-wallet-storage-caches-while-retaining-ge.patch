From 2ada05e0914968a61c39dcebae67126fe15fefc3 Mon Sep 17 00:00:00 2001
From: Tejesh Mehta <tejesh.mehta@gmail.com>
Date: Mon, 7 Sep 2026 23:05:00 -0700
Subject: [PATCH] tests: adapt wallet storage caches while retaining genesis
 rejection

Decode original historical key fixtures and create current-chain caches through wallet APIs. Retain file move and password checks; explicitly reject original Monero cache.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 tests/unit_tests/wallet_storage.cpp | 41 ++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/tests/unit_tests/wallet_storage.cpp b/tests/unit_tests/wallet_storage.cpp
index bf33936..9634308 100644
--- a/tests/unit_tests/wallet_storage.cpp
+++ b/tests/unit_tests/wallet_storage.cpp
@@ -37,7 +37,37 @@ using namespace boost::filesystem;
 using namespace epee::file_io_utils;
 
 static constexpr const char WALLET_00fd416a_PRIMARY_ADDRESS[] =
-    "45p2SngJAPSJbqSiUvYfS3BfhEdxZmv8pDt25oW1LzxrZv9Uq6ARagiFViMGUE3gJk5VPWingCXVf1p2tyAy6SUeSHPhbve";
+    "M9Lds8CcBgCJbqSiUvYfS3BfhEdxZmv8pDt25oW1LzxrZv9Uq6ARagiFViMGUE3gJk5VPWingCXVf1p2tyAy6SUeSLMMvfc";
+
+// Retain the historical key-file decoder, but build a fresh cache for this chain.
+// The original cache is retained and tested below for genesis rejection.
+static void prepare_storage_wallet(const path &source, const path &target)
+{
+    std::string keys;
+    ASSERT_TRUE(load_file_to_string(source.string() + ".keys", keys));
+    tools::wallet2 w;
+    w.load("", "beepbeep", keys);
+    ASSERT_EQ(WALLET_00fd416a_PRIMARY_ADDRESS, w.get_address_as_str());
+    w.store_to(target.string(), "beepbeep");
+}
+
+TEST(wallet_storage, rejects_monero_genesis_cache)
+{
+    const path source = unit_test::data_dir / "wallet_00fd416a";
+    std::string keys, cache;
+    ASSERT_TRUE(load_file_to_string(source.string() + ".keys", keys));
+    ASSERT_TRUE(load_file_to_string(source.string(), cache));
+    tools::wallet2 w;
+    try
+    {
+        w.load("", "beepbeep", keys, cache);
+        FAIL() << "Historical Monero cache was accepted";
+    }
+    catch (const tools::error::wallet_internal_error &e)
+    {
+        EXPECT_NE(std::string::npos, std::string(e.what()).find("Genesis block mismatch"));
+    }
+}
 
 TEST(wallet_storage, store_to_file2file)
 {
@@ -48,8 +78,7 @@ TEST(wallet_storage, store_to_file2file)
     ASSERT_TRUE(is_file_exist(source_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(source_wallet_file.string() + ".keys"));
 
-    tools::copy_file(source_wallet_file.string(), interm_wallet_file.string());
-    tools::copy_file(source_wallet_file.string() + ".keys", interm_wallet_file.string() + ".keys");
+    prepare_storage_wallet(source_wallet_file, interm_wallet_file);
 
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string() + ".keys"));
@@ -139,8 +168,7 @@ TEST(wallet_storage, change_password_same_file)
     ASSERT_TRUE(is_file_exist(source_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(source_wallet_file.string() + ".keys"));
 
-    tools::copy_file(source_wallet_file.string(), interm_wallet_file.string());
-    tools::copy_file(source_wallet_file.string() + ".keys", interm_wallet_file.string() + ".keys");
+    prepare_storage_wallet(source_wallet_file, interm_wallet_file);
 
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string() + ".keys"));
@@ -178,8 +206,7 @@ TEST(wallet_storage, change_password_different_file)
     ASSERT_TRUE(is_file_exist(source_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(source_wallet_file.string() + ".keys"));
 
-    tools::copy_file(source_wallet_file.string(), interm_wallet_file.string());
-    tools::copy_file(source_wallet_file.string() + ".keys", interm_wallet_file.string() + ".keys");
+    prepare_storage_wallet(source_wallet_file, interm_wallet_file);
 
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string()));
     ASSERT_TRUE(is_file_exist(interm_wallet_file.string() + ".keys"));
