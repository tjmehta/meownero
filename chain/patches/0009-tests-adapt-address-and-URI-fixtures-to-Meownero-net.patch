 TEST(get_account_address_as_str, works_correctly)
@@ -533,6 +534,62 @@ TEST(get_account_address_from_str, fails_on_invalid_address_view_key)
   ASSERT_FALSE(cryptonote::get_account_address_from_str(info, cryptonote::MAINNET, addr_str));
 }
 
+// Fixed vectors preserve the upstream public keys; generated using the built native base58 codec.
+TEST(meow_address, network_and_address_type_vectors)
+{
+  struct vector_t {
+    cryptonote::network_type network;
+    bool integrated;
+    bool subaddress;
+    const char *encoded;
+  };
+  const vector_t vectors[] = {
+    {cryptonote::MAINNET, false, false, "MEWverazYv4dNeM6dfiBFL7kqund3HYGvMBF3ttsNd9SfzgYB6L7ep1Yg1osYJzLdaKAYSLVh6e6jKnAuzj3bw1oH1CUjnt"},
+    {cryptonote::MAINNET, true, false, "MQDbffQVABadNeM6dfiBFL7kqund3HYGvMBF3ttsNd9SfzgYB6L7ep1Yg1osYJzLdaKAYSLVh6e6jKnAuzj3bw1oQkChXgMFizXRfS6wTH"},
+    {cryptonote::MAINNET, false, true, "MjcwhH3UNicdNeM6dfiBFL7kqund3HYGvMBF3ttsNd9SfzgYB6L7ep1Yg1osYJzLdaKAYSLVh6e6jKnAuzj3bw1oGwnC6aq"},
+    {cryptonote::TESTNET, false, false, "T6UFisXHs1LY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxR2ZubZikXW"},
+    {cryptonote::TESTNET, true, false, "TGAvjgLnUGrY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxRXY1SpoPU44S1FNQseZC4"},
+    {cryptonote::TESTNET, false, true, "TRsbkVAH5YNY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxR2ZuYgn3KT"},
+    {cryptonote::STAGENET, false, false, "S6GDe2cLDQEY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxR2ZubDN5FT"},
+    {cryptonote::STAGENET, true, false, "SFxteqRppfkY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxRXY1SpoPU44S1FNLqqa2F"},
+    {cryptonote::STAGENET, false, true, "SRfZfeFKRwGY5yQcdApjMb8tVPik5BC3LFdaevfbGq7X1KY5vdsWmUi5UQgse2GBZFbMsb47TFqBmPpdFHDDwDxR2ZuYHa1Ka"},
+  };
+  cryptonote::account_public_address address;
+  ASSERT_TRUE(serialization::parse_binary(test_serialized_keys, address));
+  crypto::hash8 payment_id{};
+  std::memcpy(&payment_id, "\xf6\x12\xca\xc0\xb6\xcb\x1c\xda", sizeof(payment_id));
+  for (const auto &v : vectors)
+  {
+    SCOPED_TRACE(v.encoded);
+    const auto encoded = v.integrated
+      ? cryptonote::get_account_integrated_address_as_str(v.network, address, payment_id)
+      : cryptonote::get_account_address_as_str(v.network, v.subaddress, address);
+    ASSERT_EQ(encoded, v.encoded);
+    cryptonote::address_parse_info info{};
+    ASSERT_TRUE(cryptonote::get_account_address_from_str(info, v.network, v.encoded));
+    ASSERT_EQ(info.is_subaddress, v.subaddress);
+    ASSERT_EQ(info.has_payment_id, v.integrated);
+    std::string keys;
+    ASSERT_TRUE(serialization::dump_binary(info.address, keys));
+    ASSERT_EQ(keys, test_serialized_keys);
+    if (v.integrated) ASSERT_EQ(info.payment_id, payment_id);
+    for (const auto other : {cryptonote::MAINNET, cryptonote::TESTNET, cryptonote::STAGENET})
+      if (other != v.network)
+        ASSERT_FALSE(cryptonote::get_account_address_from_str(info, other, v.encoded));
+    std::string corrupt = v.encoded;
+    corrupt.back() = corrupt.back() == '1' ? '2' : '1';
+    ASSERT_FALSE(cryptonote::get_account_address_from_str(info, v.network, corrupt));
+  }
+}
+
+TEST(meow_address, rejects_monero_base58_address)
+{
+  cryptonote::address_parse_info info{};
+  for (const auto network : {cryptonote::MAINNET, cryptonote::TESTNET, cryptonote::STAGENET})
+    ASSERT_FALSE(cryptonote::get_account_address_from_str(info, network,
+      "4AzKEX4gXdJdNeM6dfiBFL7kqund3HYGvMBF3ttsNd9SfzgYB6L7ep1Yg1osYJzLdaKAYSLVh6e6jKnAuzj3bw1oGy9kXCb"));
+}
+
 TEST(get_account_address_from_str, parses_old_address_format)
 {
   cryptonote::address_parse_info info;
