table inet meownero_seed {
    set seed_sources {
        type ipv4_addr;
        size 65535;
        flags dynamic,timeout;
        timeout 1m;
    }
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept;
        ct state invalid drop;
        ct state established,related accept;
        iifname "eth0" ip daddr 192.0.2.10 tcp dport 48080 ct state new update @seed_sources { ip saddr limit rate over 30/minute burst 10 packets } drop;
        iifname "eth0" ip daddr 192.0.2.10 tcp dport 48080 ct state new ip saddr != @seed_sources limit rate over 120/minute burst 60 packets drop;
        iifname "eth0" ip daddr 192.0.2.10 tcp dport 48080 ct state new accept;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
