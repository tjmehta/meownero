+def windows_arm64_qualification(backend, package, row):
+    """Require native ARM64 CPython and exact ARM64 programs before spawning."""
+    assert os.name == 'nt' and platform.python_implementation() == 'CPython'
+    assert sys.version_info >= (3, 13) and platform.machine().upper() in ('ARM64', 'AARCH64')
+    assert backend.C.sizeof(backend.C.c_void_p) == 8
+    assert backend.native_architecture() == 'aarch64'
+    process, native = backend.W.USHORT(), backend.W.USHORT()
+    backend.check(backend.api(backend.k, 'IsWow64Process2', backend.W.BOOL,
+        backend.W.HANDLE, backend.C.POINTER(backend.W.USHORT), backend.C.POINTER(backend.W.USHORT))(
+        backend._winapi.GetCurrentProcess(), backend.C.byref(process), backend.C.byref(native)))
+    assert process.value == 0 and native.value == 0xaa64, 'native ARM64 process required; emulation refused'
+    crypto = backend.api(backend.k, 'IsProcessorFeaturePresent', backend.W.BOOL, backend.W.DWORD)(30)
+    assert crypto, 'ARMv8 crypto instructions required by exact compile flags'
+
+    def machine(path):
+        with path.open('rb') as stream:
+            header = stream.read(64)
+            assert len(header) == 64 and header[:2] == b'MZ', 'PE DOS header required'
+            offset = int.from_bytes(header[60:64], 'little')
+            assert 64 <= offset <= path.stat().st_size - 26, 'PE offset out of bounds'
+            stream.seek(offset)
+            header = stream.read(26)
+        assert header[:4] == b'PE\0\0' and header[24:26] == b'\x0b\x02', 'PE32+ required'
+        assert int.from_bytes(header[4:6], 'little') == 0xaa64, 'native ARM64 PE required'
+        return 0xaa64
+
+    python_machine = machine(Path(sys.executable))
+    for name, digest in row['program_sha256'].items():
+        assert name in ('monerod', 'monero-wallet-cli', 'monero-wallet-rpc')
+        path = package / 'bin' / (name + '.exe')
+        assert sha(path) == digest, 'program binding changed before native qualification'
+        machine(path)
+    assert set(row['program_sha256']) == {'monerod', 'monero-wallet-cli', 'monero-wallet-rpc'}
+    return {'process_machine': process.value, 'native_machine': native.value,
+            'python_machine': python_machine, 'python_sha256': sha(Path(sys.executable)),
+            'armv8_crypto': True, 'programs_arm64': True, 'emulation': False}
+
+
